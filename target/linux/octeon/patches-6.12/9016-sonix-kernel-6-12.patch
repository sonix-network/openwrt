Subject: [PATCH] sonix: Update for kernel 6.12

diff --git a/drivers/mfd/cisco-n821-cpld.c b/drivers/mfd/cisco-n821-cpld.c
index 80fd678d4ab2..fad32254b8d1 100644
--- a/drivers/mfd/cisco-n821-cpld.c
+++ b/drivers/mfd/cisco-n821-cpld.c
@@ -120,9 +120,8 @@ static int n821_cpld_probe(struct platform_device *pdev)
   return devm_device_add_group(dev, &n821_cpld_group);
 }
 
-static int n821_cpld_remove(struct platform_device *pdev)
+static void n821_cpld_remove(struct platform_device *pdev)
 {
-  return 0;
 }
 
 
-- 
2.51.0

